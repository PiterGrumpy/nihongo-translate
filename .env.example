# Plantilla de variables de entorno. Copia este archivo a .env y rellena los valores.
# .env NUNCA se sube a git (está en .gitignore).

# Qué proveedor usa /api/translate. De momento solo "gemini" está implementado.
AI_PROVIDER=gemini

# Clave de la API de Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modelo de trabajo. Debe existir en la capa gratuita.
# 3.5-flash-lite: medido en 4-6 s incluso con gramática y frases largas.
# 3.8-flash se midió en 40 s (y con 503 frecuentes): no usar como principal.
GEMINI_MODEL=gemini-3.5-flash-lite

# Modelo de reserva: si el principal tarda más de GEMINI_HEDGE_DELAY_MS o falla por
# saturación/cupo/timeout, la reserva sale en paralelo y gana el primero que termine.
# Déjalo vacío para desactivar la reserva (y la carrera).
GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# Cuánto espera el servidor a la IA en cada intento (milisegundos). 15000 = 15 s.
# Con un modelo rápido sobra margen; si se cuelga, no bloquea la app medio minuto.
GEMINI_TIMEOUT_MS=15000

# Si el modelo principal no contesta en este tiempo, el de reserva sale en paralelo
# y gana el primero que termine. 1500 = 1,5 s. Súbelo para gastar menos cupo.
GEMINI_HEDGE_DELAY_MS=1500

# Opcional. Tokens de "pensamiento" permitidos. Vacío = no se envía el campo.
# Solo tiene sentido con modelos que "piensan" (los Flash no lite); 0 lo desactiva.
# Ojo: algunos modelos lite rechazan el campo con un 400.
GEMINI_THINKING_BUDGET=
